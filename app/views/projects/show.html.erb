<% content_for :title, @project.name %>

<h1><%= @project.name %></h1>
<p>Status: <%= @project.status %></p>
<p><%= @project.description %></p>

<p>
  <%= link_to "Edit", edit_project_path(@project) %>
  <%= button_to "Delete", @project, method: :delete, form: { data: { turbo_confirm: "Delete this project and all its tasks?" } } %>
</p>

<h2>Tasks</h2>
<p><%= link_to "New task", new_project_task_path(@project) %></p>

<ul>
  <% @project.tasks.order(:due_date).each do |task| %>
    <li>
      <%= link_to task.title, task %>
      &mdash; <%= task.status %>
      <% if task.due_date %>(due <%= task.due_date %>)<% end %>
    </li>
  <% end %>
</ul>

<p><%= link_to "Back to projects", projects_path %></p>
